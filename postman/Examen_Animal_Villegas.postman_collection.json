  "item": [
    {
      "name": "01 - Crear animal (POST - 201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El servidor responde 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const respuesta = pm.response.json();",
              "if (respuesta.id !== undefined) {",
              "    pm.collectionVariables.set('animalId', respuesta.id);",
              "    console.log('ID guardado:', respuesta.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Usuario",
            "value": "nicolas"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"Max\",\n    \"especie\": \"Perro\",\n    \"raza\": \"Labrador\",\n    \"edad\": 3,\n    \"peso\": 25.5,\n    \"color\": \"Dorado\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/animales",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "animales"
          ]
        }
      },
      "response": []
